# This serves as a template for environment variables and is used in two ways:

# 1. Local Dev: Create a .env file and fill out the content (.gitignored).
# 2. Cloudflare Pages:
#       Cloudflare populates environment variables directly into memory. Populate them via:
#       Workers & Pages -> my-website -> Settings -> Environment variables

# Base URL of your Immich instance (without trailing slash)
IMMICH_API_URL=https://photos.valorant.nyc

# Immich API Key (Read-Only access recommended)
# Immich -> Account Settings -> API Keys
IMMICH_API_KEY=your_immich_api_key_here

